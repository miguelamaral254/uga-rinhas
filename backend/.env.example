APP_NAME="LoL Tracker"
ENVIRONMENT=development
PORT=8000

DATABASE_URL=postgresql+asyncpg://lol:lol@localhost:5432/lol_tracker
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Get one at https://developer.riotgames.com/ (personal key, expires in 24h -
# request a persistent "Personal API Key" if you want this running unattended)
RIOT_API_KEY=

# Platform routing (summoner-v4 style endpoints) - br1, na1, euw1, etc.
RIOT_PLATFORM=br1
# Regional routing (account-v1, match-v5) - americas, europe, asia
RIOT_REGION=americas

SYNC_INTERVAL_MINUTES=10

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174
